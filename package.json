{
  "name": "voice-dashboards-root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "eval"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev --workspace=@vd/server\" \"npm run dev --workspace=@vd/web\"",
    "build": "npm run build --workspace=@vd/shared && npm run build --workspace=@vd/server && npm run build --workspace=@vd/web",
    "test": "vitest run",
    "typecheck": "tsc -b packages/shared apps/server apps/web eval",
    "lint": "eslint . --ext .ts,.tsx",
    "db:seed": "tsx db/seed.ts",
    "eval": "tsx eval/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
